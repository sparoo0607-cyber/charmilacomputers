# Supabase — client (safe to expose; shipped in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://genhheydpoywoqhdavmy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase — server only. NO NEXT_PUBLIC_ PREFIX. Never expose to the browser.
# Used by src/app/api/theme to persist the active theme past the "admins write"
# RLS policy. Add this in Vercel → Project → Settings → Environment Variables.
# If omitted, the theme API falls back to the anon key for the write.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
